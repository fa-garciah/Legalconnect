# Three roles, three connection strings. This separation is not stylistic — it is
# the mechanism that makes tenant isolation real (research.md D4).

# Migration / owner role. Runs DDL and OWNS the tables.
# Never used by the running application.
DATABASE_URL_MIGRATION=postgresql://lc_migration:lc_migration_dev@localhost:5432/legalconnect

# Application role. Owns NOTHING, is not superuser, holds no BYPASSRLS.
# PostgreSQL silently ignores RLS for superusers and for the table owner, so
# connecting as either would leave every policy written and the isolation
# nonexistent — with the test suite still green. src/main.ts asserts these
# attributes at startup and refuses to boot if they are wrong.
DATABASE_URL_APP=postgresql://lc_app:lc_app_dev@localhost:5432/legalconnect

# Platform administration role. Cross-tenant reach deliberately limited to the
# tenant, plan and audit_event tables — no business table (research.md D9).
DATABASE_URL_PLATFORM=postgresql://lc_platform:lc_platform_dev@localhost:5432/legalconnect

# Retention role. May drop audit partitions past the 24-month window (FR-019).
# The application deliberately does not hold this connection.
DATABASE_URL_RETENTION=postgresql://lc_retention:lc_retention_dev@localhost:5432/legalconnect

PORT=3000

# The platform administration surface authenticates nothing in this slice, so it is
# bound to loopback only and must not be exposed to a network before slice 003.
PLATFORM_BIND_HOST=127.0.0.1
