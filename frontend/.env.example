# Frontend environment. Slice 003 creates this file — `016a` needed none, because the
# shell made no network calls and read its principal from a checked-in fixture.
#
# NextAuth's role here is narrow and deliberately so (003/research.md D1): it conducts
# the browser side of the sign-in ceremony and holds the resulting cookie. It verifies
# nothing. There is no NextAuth database adapter and no NextAuth session strategy — the
# API's own `session` table is the sole authority, and every API request re-validates
# against it (FR-034, SC-020). The cookie is transport, not proof.

# Canonical origin of this frontend. NextAuth builds its callback URLs from it, and a
# wrong value sends a person back to a URL that does not exist after sign-in.
NEXTAUTH_URL=http://localhost:3000

# Encrypts the session cookie whose payload is the API's opaque access credential.
#
# THE VALUE BELOW IS A PLACEHOLDER AND PROTECTS NOTHING. Generate a real one per
# environment with `openssl rand -base64 32`, and keep it in the secrets manager —
# never in this repository (Constitution Principle VI). Rotating it invalidates every
# browser cookie, which is a sign-out for everyone, not a data loss: the API's `session`
# rows are untouched and are what actually decide validity.
NEXTAUTH_SECRET=replace-me-generate-with-openssl-rand-base64-32

# Where the NestJS API lives. The Credentials provider's `authorize()` calls it and
# returns whatever the API decides; it never verifies a credential itself.
#
# NEXT_PUBLIC_ because the browser also calls the API directly for tenant-scoped reads
# (018, 019). Nothing secret may ever be put behind a NEXT_PUBLIC_ name — the value is
# inlined into the client bundle and is world-readable.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
